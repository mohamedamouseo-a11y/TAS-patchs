+export const createTASVehicle = async (input: AnyRow) => {
+  const centralBrand = input.brandId ? await requireActiveTASVehicleBrand(Number(input.brandId)) : null;
+  const brand = centralBrand?.nameEn ?? String(input.brand ?? "").trim();
+  if (!brand) throw new Error("Vehicle brand is required");
+  return createVehicleRow({
+    brandId: centralBrand?.id ?? null,
+    brand,
+    model: input.model,
+    year: input.modelYear ?? input.year ?? null,
+    price: input.cashPrice ?? input.price ?? 0,
+    colors: input.colors ?? [],
+    specifications: Array.isArray(input.specifications)
+      ? input.specifications
+      : [{ key: "Summary", value: typeof input.specs === "string" ? input.specs : input.specs?.summary ?? input.trim ?? "" }].filter((item) => item.value),
+    branchAvailability: input.branchAvailability ?? defaultBranches.map((branch) => branch.city),
+    faq: input.faq ?? [],
+  });
+};
 
