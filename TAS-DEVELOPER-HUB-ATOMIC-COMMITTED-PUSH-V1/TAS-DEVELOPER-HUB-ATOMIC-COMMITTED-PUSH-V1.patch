+export type AtomicCommittedHeadDecision =
+  | { mode: "none"; reason: null }
+  | { mode: "push_local_head"; reason: null }
+  | { mode: "blocked"; reason: string };
+
+export function decideAtomicCommittedHead(input: {
+  atomicWorkspaceIsolation: boolean;
+  remoteExists: boolean;
+  localAhead: number;
+  remoteAhead: number;
+  historiesRelated: boolean;
+  activeCandidateCompatibleWithLocalHead: boolean;
+}): AtomicCommittedHeadDecision {
+  if (!input.atomicWorkspaceIsolation || !input.remoteExists || input.localAhead <= 0) {
+    return { mode: "none", reason: null };
+  }
+  if (!input.historiesRelated) {
+    return {
+      mode: "blocked",
+      reason: "The local TAS branch and selected GitHub branch have unrelated histories.",
+    };
+  }
+  if (input.remoteAhead > 0) {
+    return {
+      mode: "blocked",
+      reason: "Atomic Developer Hub detected both local and GitHub commits. Review and resolve both directions before pushing.",
+    };
+  }
+  if (!input.activeCandidateCompatibleWithLocalHead) {
+    return {
+      mode: "blocked",
+      reason: "DUAL_SOURCE_DIVERGENCE: active release source contains changes that do not match the committed local HEAD.",
+    };
+  }
+  return { mode: "push_local_head", reason: null };
+}
+
 export function createAdvancedSyncFingerprint(input: Record<string, unknown>) {
