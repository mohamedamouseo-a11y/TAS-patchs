--- /dev/null
+++ b/server/services/developerHubGitHubAdvancedSync.test.ts
@@ -0,0 +1,76 @@
+import { describe, expect, it } from "vitest";
+import {
+  decideAtomicCommittedHead,
+  decideGitHubSyncPlan,
+} from "./developerHubGitHubAdvancedSync";
+
+describe("Developer Hub atomic committed HEAD", () => {
+  it("pushes the committed local HEAD when atomic active source is compatible", () => {
+    expect(decideAtomicCommittedHead({
+      atomicWorkspaceIsolation: true,
+      remoteExists: true,
+      localAhead: 1,
+      remoteAhead: 0,
+      historiesRelated: true,
+      activeCandidateCompatibleWithLocalHead: true,
+    })).toEqual({ mode: "push_local_head", reason: null });
+  });
+
+  it("blocks atomic both-ahead state", () => {
+    const result = decideAtomicCommittedHead({
+      atomicWorkspaceIsolation: true,
+      remoteExists: true,
+      localAhead: 1,
+      remoteAhead: 1,
+      historiesRelated: true,
+      activeCandidateCompatibleWithLocalHead: true,
+    });
+    expect(result.mode).toBe("blocked");
+  });
+
+  it("blocks incompatible active release source", () => {
+    const result = decideAtomicCommittedHead({
+      atomicWorkspaceIsolation: true,
+      remoteExists: true,
+      localAhead: 1,
+      remoteAhead: 0,
+      historiesRelated: true,
+      activeCandidateCompatibleWithLocalHead: false,
+    });
+    expect(result.mode).toBe("blocked");
+    if (result.mode === "blocked") expect(result.reason).toContain("DUAL_SOURCE_DIVERGENCE");
+  });
+
+  it("does nothing when local HEAD is not ahead", () => {
+    expect(decideAtomicCommittedHead({
+      atomicWorkspaceIsolation: true,
+      remoteExists: true,
+      localAhead: 0,
+      remoteAhead: 0,
+      historiesRelated: true,
+      activeCandidateCompatibleWithLocalHead: true,
+    })).toEqual({ mode: "none", reason: null });
+  });
+
+  it("does nothing outside atomic isolation", () => {
+    expect(decideAtomicCommittedHead({
+      atomicWorkspaceIsolation: false,
+      remoteExists: true,
+      localAhead: 2,
+      remoteAhead: 0,
+      historiesRelated: true,
+      activeCandidateCompatibleWithLocalHead: true,
+    })).toEqual({ mode: "none", reason: null });
+  });
+
+  it("keeps the existing push planner behavior for committed local commits", () => {
+    expect(decideGitHubSyncPlan({
+      action: "push",
+      dirty: false,
+      localAhead: 1,
+      remoteAhead: 0,
+      remoteExists: true,
+      branchMatches: true,
+    }).expectedAction).toBe("push");
+  });
+});
