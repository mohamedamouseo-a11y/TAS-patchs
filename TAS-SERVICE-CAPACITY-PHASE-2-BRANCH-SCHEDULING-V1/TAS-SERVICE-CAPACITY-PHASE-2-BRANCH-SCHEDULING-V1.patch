+++ b/scripts/apply-tas-service-branch-scheduling-v1.ts
@@ -0,0 +1,96 @@
+import "dotenv/config";
+import fs from "node:fs";
+import path from "node:path";
+import mysql from "mysql2/promise";
+
+const LOCK = "tas-service-branch-scheduling-v1";
+const STATE = path.join(process.cwd(), "storage", "migrations", "tas-service-branch-scheduling-v1-state.json");
+const COLUMNS = [
+  ["workingDaysJson", "JSON NULL AFTER workingHours"],
+  ["workdayStartMinutes", "INT NOT NULL DEFAULT 540 AFTER slotIntervalMinutes"],
+  ["workdayEndMinutes", "INT NOT NULL DEFAULT 1080 AFTER workdayStartMinutes"],
+  ["bookingStartMinutes", "INT NOT NULL DEFAULT 540 AFTER workdayEndMinutes"],
+  ["bookingEndMinutes", "INT NOT NULL DEFAULT 1020 AFTER bookingStartMinutes"],
+  ["endOfDayBufferMinutes", "INT NOT NULL DEFAULT 60 AFTER bookingEndMinutes"],
+] as const;
+
+async function main() {
+  if (!process.argv.includes("--apply")) throw new Error("Use --apply");
+  if (!process.env.DATABASE_URL) throw new Error("DATABASE_URL is required");
+  const db = await mysql.createConnection(process.env.DATABASE_URL);
+  const [databaseRows] = await db.query<any[]>("SELECT DATABASE() db");
+  const databaseName = String(databaseRows?.[0]?.db ?? "");
+  if (databaseName !== "tas_crm") {
+    await db.end();
+    throw new Error(`Refusing unexpected database: ${databaseName || "<none>"}`);
+  }
+  let locked = false;
+  const state: { version: number; added: string[]; preexisting: string[] } = { version: 1, added: [], preexisting: [] };
+
+  const tableExists = async (name: string) => {
+    const [rows] = await db.execute<any[]>(
+      "SELECT COUNT(*) c FROM information_schema.TABLES WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME=?",
+      [name],
+    );
+    return Number(rows?.[0]?.c ?? 0) > 0;
+  };
+  const columnExists = async (name: string) => {
+    const [rows] = await db.execute<any[]>(
+      "SELECT COUNT(*) c FROM information_schema.COLUMNS WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='tas_branches' AND COLUMN_NAME=?",
+      [name],
+    );
+    return Number(rows?.[0]?.c ?? 0) > 0;
+  };
+  const persist = () => {
+    fs.mkdirSync(path.dirname(STATE), { recursive: true });
+    fs.writeFileSync(STATE, JSON.stringify(state, null, 2) + "\n", { mode: 0o600 });
+  };
+
+  try {
+    for (const table of ["tas_branches", "tas_service_types", "tas_service_bookings"]) {
+      if (!(await tableExists(table))) throw new Error(`Required table missing: ${table}`);
+    }
+    const [lockRows] = await db.query<any[]>("SELECT GET_LOCK(?, 10) acquired", [LOCK]);
+    locked = Number(lockRows?.[0]?.acquired ?? 0) === 1;
+    if (!locked) throw new Error("Could not acquire migration lock");
+
+    for (const [name, definition] of COLUMNS) {
+      if (await columnExists(name)) {
+        state.preexisting.push(name);
+        persist();
+        continue;
+      }
+      await db.query(`ALTER TABLE tas_branches ADD COLUMN \`${name}\` ${definition}`);
+      state.added.push(name);
+      persist();
+      if (name === "workingDaysJson") {
+        await db.query("UPDATE tas_branches SET workingDaysJson=JSON_ARRAY(0,1,2,3,4,5,6) WHERE workingDaysJson IS NULL");
+      } else if (name === "workdayStartMinutes") {
+        await db.query("UPDATE tas_branches SET workdayStartMinutes=COALESCE(workdayStartHour,9)*60");
+      } else if (name === "workdayEndMinutes") {
+        await db.query("UPDATE tas_branches SET workdayEndMinutes=COALESCE(workdayEndHour,18)*60");
+      } else if (name === "bookingStartMinutes") {
+        await db.query("UPDATE tas_branches SET bookingStartMinutes=COALESCE(workdayStartMinutes,COALESCE(workdayStartHour,9)*60)");
+      } else if (name === "bookingEndMinutes") {
+        await db.query("UPDATE tas_branches SET bookingEndMinutes=GREATEST(COALESCE(workdayStartMinutes,540),COALESCE(workdayEndMinutes,1080)-60)");
+      }
+    }
+
+    console.log("TAS_SERVICE_BRANCH_SCHEDULING_MIGRATION=PASS");
+    console.log("ADDED_COLUMNS=" + (state.added.join(",") || "NONE"));
+    console.log("PREEXISTING_COLUMNS=" + (state.preexisting.join(",") || "NONE"));
+    console.log("ERROR=NONE");
+  } catch (error) {
+    persist();
+    throw error;
+  } finally {
+    if (locked) await db.query("SELECT RELEASE_LOCK(?)", [LOCK]).catch(() => undefined);
+    await db.end();
+  }
+}
+
+main().catch((error) => {
+  console.error("TAS_SERVICE_BRANCH_SCHEDULING_MIGRATION=FAIL");
+  console.error("ERROR=" + (error instanceof Error ? error.message : String(error)));
+  process.exit(1);
+});
diff --git a/scripts/verify-tas-service-branch-scheduling-v1.ts b/scripts/verify-tas-service-branch-scheduling-v1.ts
new file mode 100644
--- /dev/null
+++ b/scripts/verify-tas-service-branch-scheduling-v1.ts
@@ -0,0 +1,59 @@
+import "dotenv/config";
+import fs from "node:fs";
+import path from "node:path";
+import mysql from "mysql2/promise";
+
+const STATE = path.join(process.cwd(), "storage", "migrations", "tas-service-branch-scheduling-v1-state.json");
+const REQUIRED = ["workingDaysJson","workdayStartMinutes","workdayEndMinutes","bookingStartMinutes","bookingEndMinutes","endOfDayBufferMinutes"];
+
+async function main() {
+  if (!process.env.DATABASE_URL) throw new Error("DATABASE_URL is required");
+  const rolledBack = process.argv.includes("--rolled-back");
+  const db = await mysql.createConnection(process.env.DATABASE_URL);
+  try {
+    const [rows] = await db.query<any[]>(
+      "SELECT COLUMN_NAME name FROM information_schema.COLUMNS WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='tas_branches'",
+    );
+    const columns = new Set(rows.map((row) => String(row.name)));
+
+    if (rolledBack) {
+      const state = fs.existsSync(STATE) ? JSON.parse(fs.readFileSync(STATE, "utf8")) : { added: [], preexisting: [] };
+      for (const name of state.added ?? []) {
+        if (columns.has(name)) throw new Error(`Rollback left added column: ${name}`);
+      }
+      for (const name of state.preexisting ?? []) {
+        if (!columns.has(name)) throw new Error(`Rollback removed preexisting column: ${name}`);
+      }
+      console.log("TAS_SERVICE_BRANCH_SCHEDULING_ROLLBACK_VERIFY=PASS");
+      return;
+    }
+
+    for (const name of REQUIRED) {
+      if (!columns.has(name)) throw new Error(`Missing branch scheduling column: ${name}`);
+    }
+    const [invalid] = await db.query<any[]>(`
+      SELECT COUNT(*) c
+      FROM tas_branches
+      WHERE workdayStartMinutes < 0 OR workdayStartMinutes >= 1440
+         OR workdayEndMinutes <= workdayStartMinutes OR workdayEndMinutes > 1440
+         OR bookingStartMinutes < workdayStartMinutes
+         OR bookingEndMinutes < bookingStartMinutes
+         OR bookingEndMinutes > workdayEndMinutes
+         OR slotIntervalMinutes < 15
+         OR endOfDayBufferMinutes < 0
+         OR endOfDayBufferMinutes >= (workdayEndMinutes-workdayStartMinutes)
+    `);
+    if (Number(invalid?.[0]?.c ?? 0) > 0) throw new Error("Invalid branch scheduling rows detected");
+    const [counts] = await db.query<any[]>("SELECT COUNT(*) branches FROM tas_branches");
+    console.log("TAS_SERVICE_BRANCH_SCHEDULING_VERIFY=PASS");
+    console.log("BRANCH_ROWS=" + Number(counts?.[0]?.branches ?? 0));
+    console.log("ERROR=NONE");
+  } finally {
+    await db.end();
+  }
+}
+main().catch((error) => {
+  console.error("TAS_SERVICE_BRANCH_SCHEDULING_VERIFY=FAIL");
+  console.error("ERROR=" + (error instanceof Error ? error.message : String(error)));
+  process.exit(1);
+});
