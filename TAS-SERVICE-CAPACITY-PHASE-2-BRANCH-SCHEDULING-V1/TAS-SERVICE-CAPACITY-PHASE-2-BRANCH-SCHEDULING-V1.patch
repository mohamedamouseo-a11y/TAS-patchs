+import { useEffect, useMemo, useState } from 'react';
+import { Building2, CalendarDays, Clock3, Plus, Save, TimerReset } from 'lucide-react';
+import { toast } from 'sonner';
+import { SectionCard, FieldGroup, FieldLabel } from '@/components/tas/TASShared';
+import { useLanguage } from '@/contexts/LanguageContext';
+import { trpc } from '@/lib/trpc';
+import { Badge } from '@/components/ui/badge';
+import { Button } from '@/components/ui/button';
+import { Input } from '@/components/ui/input';
+import { Select, SelectContent, SelectItem, SelectTrigger, SelectValue } from '@/components/ui/select';
+import { Switch } from '@/components/ui/switch';
+
+const DAYS = [
+  { id: 0, en: 'Sun', ar: 'الأحد' },
+  { id: 1, en: 'Mon', ar: 'الإثنين' },
+  { id: 2, en: 'Tue', ar: 'الثلاثاء' },
+  { id: 3, en: 'Wed', ar: 'الأربعاء' },
+  { id: 4, en: 'Thu', ar: 'الخميس' },
+  { id: 5, en: 'Fri', ar: 'الجمعة' },
+  { id: 6, en: 'Sat', ar: 'السبت' },
+];
+
+function clampMinutes(value: unknown, fallback: number) {
+  const parsed = Number(value);
+  if (!Number.isFinite(parsed)) return fallback;
+  return Math.max(0, Math.min(1439, Math.round(parsed)));
+}
+
+function minutesToTime(value: unknown, fallback: number) {
+  const total = clampMinutes(value, fallback);
+  return `${String(Math.floor(total / 60)).padStart(2, '0')}:${String(total % 60).padStart(2, '0')}`;
+}
+
+function timeToMinutes(value: string) {
+  const [hour, minute] = String(value || '').split(':').map(Number);
+  if (!Number.isFinite(hour) || !Number.isFinite(minute)) return 0;
+  return Math.max(0, Math.min(1439, hour * 60 + minute));
+}
+
+function normalizeDays(value: unknown): number[] {
+  let source = value;
+  if (typeof source === 'string') {
+    try { source = JSON.parse(source); } catch { source = []; }
+  }
+  if (!Array.isArray(source)) return [0, 1, 2, 3, 4, 5, 6];
+  const days = Array.from(new Set(source.map(Number).filter((day) => Number.isInteger(day) && day >= 0 && day <= 6)));
+  return days.length ? days : [0, 1, 2, 3, 4, 5, 6];
+}
+
+function draftFromBranch(branch?: any) {
+  const start = branch?.workdayStartMinutes ?? Number(branch?.workdayStartHour ?? 9) * 60;
+  const end = branch?.workdayEndMinutes ?? Number(branch?.workdayEndHour ?? 18) * 60;
+  return {
+    name: branch?.name ?? '',
+    city: branch?.city ?? '',
+    address: branch?.address ?? '',
+    phone: branch?.phone ?? '',
+    workdayStart: minutesToTime(start, 540),
+    workdayEnd: minutesToTime(end, 1080),
+    bookingStart: minutesToTime(branch?.bookingStartMinutes ?? start, 540),
+    bookingEnd: minutesToTime(branch?.bookingEndMinutes ?? Math.max(Number(start), Number(end) - 60), 1020),
+    slotIntervalMinutes: String(branch?.slotIntervalMinutes ?? 30),
+    endOfDayBufferMinutes: String(branch?.endOfDayBufferMinutes ?? 60),
+    workingDays: normalizeDays(branch?.workingDaysJson),
+    isActive: branch?.isActive === undefined ? true : Number(branch.isActive) === 1,
+  };
+}
+
+export default function TASBranchSchedulingSettings() {
+  const { isRTL } = useLanguage();
+  const utils = trpc.useUtils();
+  const branchesQ = trpc.tas.branches.list.useQuery({ includeInactive: true });
+  const branches = branchesQ.data ?? [];
+  const [selectedId, setSelectedId] = useState<string>('');
+  const selectedBranch = useMemo(
+    () => branches.find((branch: any) => String(branch.id) === selectedId),
+    [branches, selectedId],
+  );
+  const [draft, setDraft] = useState(() => draftFromBranch());
+
+  useEffect(() => {
+    if (!branchesQ.isSuccess) return;
+    if (!branches.length) {
+      if (selectedId !== 'new') setSelectedId('new');
+      return;
+    }
+    if (!selectedId) setSelectedId(String(branches[0].id));
+  }, [branchesQ.isSuccess, branches, selectedId]);
+
+  useEffect(() => {
+    if (selectedId === 'new') {
+      setDraft(draftFromBranch());
+      return;
+    }
+    if (selectedBranch) setDraft(draftFromBranch(selectedBranch));
+  }, [selectedId, selectedBranch]);
+
+  const refresh = async () => {
+    await utils.tas.branches.list.invalidate();
+    await utils.tas.service.getAvailableSlots.invalidate();
+  };
+
+  const createBranch = trpc.tas.branches.create.useMutation({
+    onSuccess: async (result: any) => {
+      toast.success(isRTL ? 'تم إنشاء الفرع وإعداد جدول التشغيل' : 'Branch schedule created');
+      await refresh();
+      if (result?.id) setSelectedId(String(result.id));
+    },
+    onError: (error) => toast.error(error.message || (isRTL ? 'تعذر إنشاء الفرع' : 'Could not create branch')),
+  });
+
+  const updateBranch = trpc.tas.branches.update.useMutation({
+    onSuccess: async () => {
+      toast.success(isRTL ? 'تم حفظ إعدادات الفرع' : 'Branch settings saved');
+      await refresh();
+    },
+    onError: (error) => toast.error(error.message || (isRTL ? 'تعذر حفظ الإعدادات' : 'Could not save settings')),
+  });
+
+  const toggleDay = (day: number) => {
+    setDraft((prev) => ({
+      ...prev,
+      workingDays: prev.workingDays.includes(day)
+        ? prev.workingDays.filter((item) => item !== day)
+        : [...prev.workingDays, day].sort((a, b) => a - b),
+    }));
+  };
+
+  const save = () => {
+    const workdayStartMinutes = timeToMinutes(draft.workdayStart);
+    const workdayEndMinutes = timeToMinutes(draft.workdayEnd);
+    const bookingStartMinutes = timeToMinutes(draft.bookingStart);
+    const bookingEndMinutes = timeToMinutes(draft.bookingEnd);
+    const endOfDayBufferMinutes = Number(draft.endOfDayBufferMinutes);
+
+    if (!draft.name.trim()) {
+      toast.error(isRTL ? 'اكتب اسم الفرع' : 'Branch name is required');
+      return;
+    }
+    if (!draft.workingDays.length) {
+      toast.error(isRTL ? 'اختر يوم عمل واحد على الأقل' : 'Select at least one working day');
+      return;
+    }
+    if (workdayStartMinutes >= workdayEndMinutes) {
+      toast.error(isRTL ? 'وقت نهاية العمل يجب أن يكون بعد وقت البداية' : 'Workday end must be after start');
+      return;
+    }
+    if (
+      bookingStartMinutes < workdayStartMinutes ||
+      bookingEndMinutes > workdayEndMinutes ||
+      bookingStartMinutes > bookingEndMinutes
+    ) {
+      toast.error(isRTL ? 'نافذة الحجز يجب أن تكون داخل ساعات العمل' : 'Booking window must stay inside working hours');
+      return;
+    }
+    if (workdayEndMinutes - endOfDayBufferMinutes <= workdayStartMinutes) {
+      toast.error(isRTL ? 'وقت الـBuffer أكبر من يوم العمل' : 'End-of-day buffer is too large');
+      return;
+    }
+
+    const payload = {
+      name: draft.name.trim(),
+      city: draft.city.trim() || null,
+      address: draft.address.trim() || null,
+      phone: draft.phone.trim() || null,
+      workingDaysJson: draft.workingDays,
+      workdayStartMinutes,
+      workdayEndMinutes,
+      bookingStartMinutes,
+      bookingEndMinutes,
+      slotIntervalMinutes: Number(draft.slotIntervalMinutes),
+      endOfDayBufferMinutes,
+      isActive: draft.isActive,
+    };
+
+    if (selectedId === 'new') createBranch.mutate(payload);
+    else updateBranch.mutate({ id: Number(selectedId), ...payload });
+  };
+
+  const busy = createBranch.isPending || updateBranch.isPending;
+
+  return (
+    <SectionCard
+      title={isRTL ? 'إعدادات تشغيل فروع الصيانة' : 'Service branch scheduling'}
