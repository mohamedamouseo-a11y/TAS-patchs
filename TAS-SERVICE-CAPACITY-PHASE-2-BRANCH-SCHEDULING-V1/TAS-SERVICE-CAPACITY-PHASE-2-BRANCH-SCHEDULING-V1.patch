+const normalizeWorkingDays = (value: unknown) => {
+  let raw = value;
+  if (typeof raw === "string") {
+    try { raw = JSON.parse(raw); } catch { raw = []; }
+  }
+  if (!Array.isArray(raw)) return [0, 1, 2, 3, 4, 5, 6];
+  const days = Array.from(new Set(raw.map(Number).filter((day) => Number.isInteger(day) && day >= 0 && day <= 6)));
+  return days.length ? days : [0, 1, 2, 3, 4, 5, 6];
+};
+
+const branchScheduleFromInput = (input: AnyRow, existing?: AnyRow) => {
+  const workdayStartMinutes = Math.max(0, Math.min(1439, toNumber(input.workdayStartMinutes, toNumber(existing?.workdayStartMinutes, toNumber(existing?.workdayStartHour, 9) * 60))));
+  const workdayEndMinutes = Math.max(1, Math.min(1440, toNumber(input.workdayEndMinutes, toNumber(existing?.workdayEndMinutes, toNumber(existing?.workdayEndHour, 18) * 60))));
+  const bookingStartMinutes = Math.max(0, Math.min(1439, toNumber(input.bookingStartMinutes, toNumber(existing?.bookingStartMinutes, workdayStartMinutes))));
+  const bookingEndMinutes = Math.max(0, Math.min(1439, toNumber(input.bookingEndMinutes, toNumber(existing?.bookingEndMinutes, Math.max(workdayStartMinutes, workdayEndMinutes - 60)))));
+  const slotIntervalMinutes = Math.max(15, Math.min(120, toNumber(input.slotIntervalMinutes, toNumber(existing?.slotIntervalMinutes, 30))));
+  const endOfDayBufferMinutes = Math.max(0, Math.min(240, toNumber(input.endOfDayBufferMinutes, toNumber(existing?.endOfDayBufferMinutes, 60))));
+  const workingDays = normalizeWorkingDays(input.workingDaysJson ?? existing?.workingDaysJson);
+
+  if (workdayEndMinutes <= workdayStartMinutes) throw new Error("Workday end must be after start");
+  if (bookingStartMinutes < workdayStartMinutes || bookingEndMinutes < bookingStartMinutes || bookingEndMinutes > workdayEndMinutes) {
+    throw new Error("Booking window must stay inside working hours");
+  }
+  if (workdayEndMinutes - endOfDayBufferMinutes <= workdayStartMinutes) throw new Error("End-of-day buffer is too large");
+
+  const formatTime = (minutes: number) => `${String(Math.floor(minutes / 60)).padStart(2, "0")}:${String(minutes % 60).padStart(2, "0")}`;
+  return {
+    workingDays,
+    workdayStartMinutes,
+    workdayEndMinutes,
+    bookingStartMinutes,
+    bookingEndMinutes,
+    slotIntervalMinutes,
+    endOfDayBufferMinutes,
+    workingHours: `${formatTime(workdayStartMinutes)} - ${formatTime(workdayEndMinutes)}`,
+  };
+};
+
+export const getTASBranches = async (options?: { includeInactive?: boolean }) => {
+  const db = await getDb();
+  if (!db) return options?.includeInactive ? defaultBranches : defaultBranches.filter((branch) => Number(branch.isActive) === 1);
+  const result = options?.includeInactive
+    ? await db.execute(sql`SELECT * FROM tas_branches ORDER BY isActive DESC, city ASC, name ASC, id ASC`)
+    : await db.execute(sql`SELECT * FROM tas_branches WHERE isActive = 1 ORDER BY city ASC, name ASC, id ASC`);
+  return (result as any)[0] ?? [];
+};
+
+export const createTASBranch = async (input: AnyRow) => {
+  const db = await getDb();
+  if (!db) return 0;
+  const name = String(input.name ?? "").trim();
+  if (!name) throw new Error("Branch name is required");
+  const schedule = branchScheduleFromInput(input);
+  const result = await db.execute(sql`
+    INSERT INTO tas_branches (
+      name, city, address, phone, workingHours, workingDaysJson,
+      capacityPerSlot, slotIntervalMinutes, workdayStartHour, workdayEndHour,
+      workdayStartMinutes, workdayEndMinutes, bookingStartMinutes, bookingEndMinutes,
+      endOfDayBufferMinutes, isActive
+    )
+    VALUES (
+      ${name}, ${input.city ?? null}, ${input.address ?? null}, ${input.phone ?? null}, ${schedule.workingHours}, ${JSON.stringify(schedule.workingDays)},
+      ${toNumber(input.capacityPerSlot, 1)}, ${schedule.slotIntervalMinutes}, ${Math.floor(schedule.workdayStartMinutes / 60)}, ${Math.ceil(schedule.workdayEndMinutes / 60)},
+      ${schedule.workdayStartMinutes}, ${schedule.workdayEndMinutes}, ${schedule.bookingStartMinutes}, ${schedule.bookingEndMinutes},
+      ${schedule.endOfDayBufferMinutes}, ${input.isActive === false || input.isActive === 0 ? 0 : 1}
+    )
+  `);
+  return Number((result as any)[0]?.insertId ?? 0);
+};
+
+export const updateTASBranch = async (branchId: number, input: AnyRow) => {
+  const db = await getDb();
+  if (!db) return false;
+  const existingResult = await db.execute(sql`SELECT * FROM tas_branches WHERE id = ${branchId} LIMIT 1`);
+  const existing = ((existingResult as any)[0] ?? [])[0];
+  if (!existing) throw new Error("Branch not found");
+  const name = String(input.name ?? existing.name ?? "").trim();
+  if (!name) throw new Error("Branch name is required");
+  const schedule = branchScheduleFromInput(input, existing);
+
+  await db.execute(sql`
+    UPDATE tas_branches
+    SET
+      name = ${name},
+      city = ${input.city ?? existing.city ?? null},
+      address = ${input.address ?? existing.address ?? null},
+      phone = ${input.phone ?? existing.phone ?? null},
+      workingHours = ${schedule.workingHours},
+      workingDaysJson = ${JSON.stringify(schedule.workingDays)},
+      slotIntervalMinutes = ${schedule.slotIntervalMinutes},
+      workdayStartHour = ${Math.floor(schedule.workdayStartMinutes / 60)},
+      workdayEndHour = ${Math.ceil(schedule.workdayEndMinutes / 60)},
+      workdayStartMinutes = ${schedule.workdayStartMinutes},
+      workdayEndMinutes = ${schedule.workdayEndMinutes},
+      bookingStartMinutes = ${schedule.bookingStartMinutes},
+      bookingEndMinutes = ${schedule.bookingEndMinutes},
+      endOfDayBufferMinutes = ${schedule.endOfDayBufferMinutes},
+      isActive = ${input.isActive === false || input.isActive === 0 ? 0 : 1}
+    WHERE id = ${branchId}
+  `);
+  return true;
+};
+
+export const getAvailableTASSlots = async (input: { day: Date; branchId?: number; serviceTypeId?: number }) => {
+  const db = await getDb();
+  const day = input.day instanceof Date ? input.day : new Date(input.day);
+  const date = day.toISOString().slice(0, 10);
+  const branches = await getTASBranches();
+  const branch = branches.find((item: AnyRow) => Number(item.id) === Number(input.branchId)) ?? branches[0];
+  if (!branch) return [];
+  const workingDays = normalizeWorkingDays(branch.workingDaysJson);
+  if (!workingDays.includes(day.getDay())) return [];
+
+  const serviceTypes = await getTASServiceTypes();
+  const serviceType = serviceTypes.find((item: AnyRow) => Number(item.id) === Number(input.serviceTypeId));
+  const durationMinutes = Math.max(15, toNumber(serviceType?.durationMinutes, 60));
+  const intervalMinutes = Math.max(15, toNumber(branch.slotIntervalMinutes, 30));
+  const capacity = Math.max(1, Math.min(toNumber(branch.capacityPerSlot, 1), toNumber(serviceType?.slotCapacity ?? serviceType?.defaultCapacityUnits, toNumber(branch.capacityPerSlot, 1))));
+  const workdayStartMinutes = toNumber(branch.workdayStartMinutes, toNumber(branch.workdayStartHour, 9) * 60);
+  const workdayEndMinutes = toNumber(branch.workdayEndMinutes, toNumber(branch.workdayEndHour, 18) * 60);
+  const bookingStartMinutes = Math.max(workdayStartMinutes, toNumber(branch.bookingStartMinutes, workdayStartMinutes));
+  const bookingEndMinutes = Math.min(workdayEndMinutes, toNumber(branch.bookingEndMinutes, workdayEndMinutes));
+  const endOfDayBufferMinutes = Math.max(0, toNumber(branch.endOfDayBufferMinutes, 60));
+  const serviceEndLimit = workdayEndMinutes - endOfDayBufferMinutes;
+  const latestStart = Math.min(bookingEndMinutes, serviceEndLimit - durationMinutes);
+  const slots = [];
+
+  for (let minutes = bookingStartMinutes; minutes <= latestStart; minutes += intervalMinutes) {
+    const startHour = Math.floor(minutes / 60);
+    const startMinute = minutes % 60;
+    const endTotal = minutes + durationMinutes;
+    const endHour = Math.floor(endTotal / 60);
+    const endMinute = endTotal % 60;
+    const startAt = `${date}T${String(startHour).padStart(2, "0")}:${String(startMinute).padStart(2, "0")}:00`;
+    const endAt = `${date}T${String(endHour).padStart(2, "0")}:${String(endMinute).padStart(2, "0")}:00`;
+    let reserved = 0;
+    if (db) {
+      const countRows = await db.execute(sql`
+        SELECT COUNT(*) AS total
+        FROM tas_service_bookings
+        WHERE branchId = ${branch.id}
+          AND status NOT IN ('Cancelled','NoShow')
+          AND COALESCE(startAt, TIMESTAMP(preferredDate, preferredTime)) < ${new Date(endAt)}
+          AND COALESCE(endAt, DATE_ADD(COALESCE(startAt, TIMESTAMP(preferredDate, preferredTime)), INTERVAL ${sql.raw(String(durationMinutes))} MINUTE)) > ${new Date(startAt)}
+      `);
+      reserved = Number(((countRows as any)[0] ?? [])[0]?.total ?? 0);
+    }
+    slots.push({ startAt, endAt, availableCapacity: Math.max(0, capacity - reserved) });
+  }
+  return slots;
+};
 
