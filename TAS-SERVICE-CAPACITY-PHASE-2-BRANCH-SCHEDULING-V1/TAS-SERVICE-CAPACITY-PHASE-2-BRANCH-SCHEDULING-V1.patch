+import "dotenv/config";
+import fs from "node:fs";
+import path from "node:path";
+import mysql from "mysql2/promise";
+
+const STATE = path.join(process.cwd(), "storage", "migrations", "tas-service-branch-scheduling-v1-state.json");
+
+async function main() {
+  if (!process.env.DATABASE_URL) throw new Error("DATABASE_URL is required");
+  if (!fs.existsSync(STATE)) {
+    console.log("TAS_SERVICE_BRANCH_SCHEDULING_ROLLBACK=PASS");
+    console.log("DROPPED_COLUMNS=NONE");
+    return;
+  }
+  const state = JSON.parse(fs.readFileSync(STATE, "utf8"));
+  const added = Array.isArray(state.added) ? [...state.added].reverse() : [];
+  const db = await mysql.createConnection(process.env.DATABASE_URL);
+  const dropped: string[] = [];
+  try {
+    for (const name of added) {
+      const [rows] = await db.execute<any[]>(
+        "SELECT COUNT(*) c FROM information_schema.COLUMNS WHERE TABLE_SCHEMA=DATABASE() AND TABLE_NAME='tas_branches' AND COLUMN_NAME=?",
+        [name],
+      );
+      if (Number(rows?.[0]?.c ?? 0) === 0) continue;
+      await db.query(`ALTER TABLE tas_branches DROP COLUMN \`${name}\``);
+      dropped.push(name);
+    }
+    console.log("TAS_SERVICE_BRANCH_SCHEDULING_ROLLBACK=PASS");
+    console.log("DROPPED_COLUMNS=" + (dropped.join(",") || "NONE"));
+  } finally {
+    await db.end();
+  }
+}
+main().catch((error) => {
+  console.error("TAS_SERVICE_BRANCH_SCHEDULING_ROLLBACK=FAIL");
+  console.error("ERROR=" + (error instanceof Error ? error.message : String(error)));
+  process.exit(1);
