diff --git a/scripts/apply-campaign-other-platform-v1.ts b/scripts/apply-campaign-other-platform-v1.ts
new file mode 100644
--- /dev/null
+++ b/scripts/apply-campaign-other-platform-v1.ts
@@ -0,0 +1,86 @@
+import path from "node:path";
+import { config as dotenvConfig } from "dotenv";
+import mysql from "mysql2/promise";
+
+dotenvConfig({ path: path.join(process.cwd(), ".env"), override: false });
+
+type Connection = mysql.Connection;
+
+async function tableExists(connection: Connection, tableName: string) {
+  const [rows] = await connection.query<any[]>(
+    `SELECT TABLE_NAME AS tableName
+     FROM INFORMATION_SCHEMA.TABLES
+     WHERE TABLE_SCHEMA = DATABASE()
+       AND TABLE_NAME = ?
+     LIMIT 1`,
+    [tableName],
+  );
+  return Boolean(rows?.[0]?.tableName);
+}
+
+async function columnExists(connection: Connection, tableName: string, columnName: string) {
+  const [rows] = await connection.query<any[]>(
+    `SELECT COLUMN_NAME AS columnName
+     FROM INFORMATION_SCHEMA.COLUMNS
+     WHERE TABLE_SCHEMA = DATABASE()
+       AND TABLE_NAME = ?
+       AND COLUMN_NAME = ?
+     LIMIT 1`,
+    [tableName, columnName],
+  );
+  return Boolean(rows?.[0]?.columnName);
+}
+
+async function main() {
+  const databaseUrl = process.env.DATABASE_URL;
+  if (!databaseUrl) throw new Error("DATABASE_URL is required");
+
+  const expectedDatabaseName = process.env.TAS_EXPECTED_DATABASE_NAME?.trim();
+  if (!expectedDatabaseName) {
+    throw new Error("TAS_EXPECTED_DATABASE_NAME is required for campaign schema reconciliation");
+  }
+
+  const apply = process.argv.includes("--apply");
+  const connection = await mysql.createConnection(databaseUrl);
+
+  try {
+    const [databaseRows] = await connection.query<any[]>("SELECT DATABASE() AS databaseName");
+    const actualDatabaseName = String(databaseRows?.[0]?.databaseName ?? "");
+    if (!actualDatabaseName || actualDatabaseName !== expectedDatabaseName) {
+      throw new Error(
+        `Database mismatch: expected ${expectedDatabaseName || "<empty>"} but connected to ${actualDatabaseName || "<none>"}`,
+      );
+    }
+
+    if (!(await tableExists(connection, "campaigns"))) {
+      throw new Error("campaigns table does not exist");
+    }
+
+    const exists = await columnExists(connection, "campaigns", "platformOther");
+    if (exists) {
+      console.log("[campaign-other-platform-v1] campaigns.platformOther already exists; no change required");
+      console.log(apply ? "TAS_CAMPAIGN_OTHER_PLATFORM_SCHEMA_APPLY=PASS" : "TAS_CAMPAIGN_OTHER_PLATFORM_SCHEMA_DRY_RUN=PASS");
+      return;
+    }
+
+    if (!apply) {
+      console.log("[campaign-other-platform-v1] dry-run: would add campaigns.platformOther VARCHAR(255) NULL");
+      console.log("TAS_CAMPAIGN_OTHER_PLATFORM_SCHEMA_DRY_RUN=PASS");
+      return;
+    }
+
+    await connection.query(
+      "ALTER TABLE campaigns ADD COLUMN platformOther VARCHAR(255) NULL AFTER platform",
+    );
+
+    console.log("[campaign-other-platform-v1] campaigns.platformOther added");
+    console.log("TAS_CAMPAIGN_OTHER_PLATFORM_SCHEMA_APPLY=PASS");
+  } finally {
+    await connection.end();
+  }
+}
+
+main().catch((error) => {
+  console.error("[campaign-other-platform-v1] migration failed", error);
+  process.exit(1);
+});
