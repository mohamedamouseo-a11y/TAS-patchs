diff --git a/server/services/developerHubSourceExportSafety.ts b/server/services/developerHubSourceExportSafety.ts
--- a/server/services/developerHubSourceExportSafety.ts
+++ b/server/services/developerHubSourceExportSafety.ts
@@ -1,5 +1,27 @@
 function normalizeRelativePath(filePath: string) {
   return filePath.replace(/\\/g, "/").replace(/^\/+/, "").toLowerCase();
+}
+
+export const DEVELOPER_HUB_GIT_MUTATION_EXCLUDE_PATHSPECS = [
+  ":(top,exclude)backups",
+] as const;
+
+export const DEVELOPER_HUB_GIT_CLEAN_EXCLUDE_PATTERN = "/backups";
+
+/**
+ * Runtime backup storage is mounted at the repository-root `backups` path.
+ * Developer Hub must treat only that exact root tree as excluded. Traversal,
+ * absolute paths, sibling names such as `backups2`, and nested `foo/backups`
+ * are deliberately not matched by this predicate.
+ */
+export function isExcludedDeveloperHubRuntimePath(relativePath: string) {
+  const slashNormalized = relativePath.replace(/\\/g, "/");
+  if (!slashNormalized || slashNormalized.startsWith("/") || slashNormalized.includes("\0")) return false;
+  const normalized = slashNormalized.replace(/\/+$/, "");
+  if (!normalized) return false;
+  const segments = normalized.split("/");
+  if (segments.some((segment) => !segment || segment === "." || segment === "..")) return false;
+  return segments[0].toLowerCase() === "backups";
 }
 
